{
  "name": "zheting",
  "private": true,
  "version": "1.4.1",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "rm -rf node_modules/.vite && vite",
    "dev:5173": "vite --host 127.0.0.1 --port 5173 --strictPort --clearScreen false",
    "build": "vite build",
    "check:versions": "node scripts/verify-versions.mjs",
    "test": "node scripts/run-tests.mjs",
    "preview": "vite preview",
    "verify": "pnpm check:versions && pnpm test && pnpm build",
    "verify:tauri": "pnpm build && pnpm tauri:build:linux",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:wsl": "WEBKIT_DISABLE_COMPOSITING_MODE=1 LIBGL_ALWAYS_SOFTWARE=1 WEBKIT_FORCE_COMPOSITING_MODE=0 tauri dev",
    "tauri:build": "tauri build --target x86_64-pc-windows-gnu",
    "tauri:build:linux": "tauri build --bundles deb,rpm"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "svelte": "^5.55.5",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "qrcode": "^1.5.4",
    "sqlocal": "^0.18.0"
  }
}
